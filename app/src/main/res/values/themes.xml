<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window chrome only; all in-app styling is done in Compose. -->
    <style name="Theme.MelloZone" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorAccent">#EF8FCB</item>
    </style>

    <style name="Theme.MelloZone.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ink</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.MelloZone</item>
    </style>
</resources>
